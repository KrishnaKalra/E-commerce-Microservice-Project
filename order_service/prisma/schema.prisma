generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
enum OrderStatus {
  CREATED
  CONFIRMED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

enum InventoryStatus {
  PENDING
  RESERVED
  FAILED
}

enum ShipmentStatus {
  PENDING
  READY
  SHIPPED
  DELIVERED
}
model Order {
  id               String   @id @default(uuid())

  createdBy          String  
  productId   String
  paymentId        String?
  quantity Int 
  status           OrderStatus @default(CREATED)
  paymentStatus    PaymentStatus @default(PENDING)
  inventoryStatus  InventoryStatus @default(PENDING)
  shipmentStatus   ShipmentStatus @default(PENDING)
  
  amount      Decimal  @db.Decimal(12,2)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

}